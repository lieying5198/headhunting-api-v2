name = "headhunting-api"
main = "api/index.js"
compatibility_date = "2024-01-01"

# D1数据库绑定
[[d1_databases]]
binding = "DB"
database_name = "headhunting-db"
database_id = "your-database-id"

# KV存储绑定
[[kv_namespaces]]
binding = "KV"
id = ""

# 环境变量（敏感信息）
[vars]
ENVIRONMENT = "production"

# 开发环境
[env.development]
vars = { ENVIRONMENT = "development" }

# 生产环境
[env.production]
vars = { ENVIRONMENT = "production" }
