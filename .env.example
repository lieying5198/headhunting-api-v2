# 环境变量配置

# 应用配置
APP_NAME=猎头加油站
APP_ENV=development
APP_PORT=3000

# 数据库配置（开发环境使用JSON文件，生产环境请使用真实数据库）
DB_TYPE=json
DB_PATH=./data

# 管理员配置
ADMIN_ID=ADMIN
ADMIN_PHONE=13800138000
ADMIN_WECHAT=admin_headhunting

# 通知配置
NOTIFICATION_INAPP=true
NOTIFICATION_WECHAT=false
NOTIFICATION_EMAIL=false
NOTIFICATION_SMS=false

# 微信消息配置（需要申请微信商户号）
WECHAT_APPID=your_appid
WECHAT_SECRET=your_secret
WECHAT_MCHID=your_mchid

# 邮件配置（需要SMTP服务）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email
SMTP_PASS=your_password

# 支付配置
PAYMENT_WECHAT_ENABLE=false
PAYMENT_ALIPAY_ENABLE=false

# 佣金配置
COMMISSION_LEVEL1_RATE=0.20
COMMISSION_LEVEL2_RATE=0.05
COMMISSION_SETTLEMENT_DAYS=7
COMMISSION_MIN_WITHDRAW=100

# 套餐价格
PRICE_MONTHLY=99
PRICE_YEARLY=599
PRICE_LIFETIME=1999

# 使用限制
LIMIT_FREE_DAILY=3
LIMIT_FREE_SEARCH=5
